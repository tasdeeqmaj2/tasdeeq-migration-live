OLD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres_tasdeeq

# Schema that holds legacy tables (user, organization, worker, …)
# prelive dump often uses tasdeeq_prelive; live DBs usually use public
OLD_SCHEMA=tasdeeq_prelive

# AES secret used by old EncryptionUtils (email / phone / cnic)
OLD_ENCRYPTION_SECRET=tasdeeq1234abc

# Target (new Prisma / Nest API)
NEW_DATABASE_URL=postgresql://tasdeeq:tasdeeq_dev@localhost:5432/tasdeeq

# Storage (MinIO) — same S3_* contract as tasdeeq/apps/api StorageService
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=tasdeeq
S3_ACCESS_KEY=tasdeeq_minio
S3_SECRET_KEY=tasdeeq_minio_dev

# Legacy asset download base (download-asset endpoint, no trailing slash)
LEGACY_ASSET_BASE_URL=https://tasdeequat.cee-solutions.com/tasdeeqPreLive
# Parallel downloads/uploads for `npm run migrate:assets`
ASSET_MIGRATE_CONCURRENCY=5
ASSET_JOB_BATCH_SIZE=200

# Performance (bulk migration)
# Rows fetched from old DB per page
MIGRATE_BATCH_SIZE=2000
# User document verification step only (default 500)
UDV_BATCH_SIZE=500
UDV_BULK_CHUNK=500
# Criminal verification forms step only (default 500)
CRIMINAL_FORM_BATCH_SIZE=500
CRIMINAL_FORM_BULK_CHUNK=500
# Persist mapping JSON every N batches (final save always happens)
MAP_SAVE_EVERY=10

# Optional: wipe maps + NEW DB migration tables before migrate
# CLEAR_MAPS=1
