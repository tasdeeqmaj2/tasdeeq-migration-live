# Ubuntu server example — both DBs on the same Postgres instance
# Copy to .env on the server and adjust passwords if needed.

# Old data restored from your .sql dump
OLD_DATABASE_URL=postgresql://tasdeeq:tasdeeq_dev@127.0.0.1:5432/tasdeeq_live
OLD_SCHEMA=public
OLD_ENCRYPTION_SECRET=tasdeeq1234abc

# New Prisma / app database on Ubuntu
NEW_DATABASE_URL=postgresql://tasdeeq:tasdeeq_dev@127.0.0.1:5432/tasdeeq

# MinIO on this server (or Docker)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=tasdeeq
S3_ACCESS_KEY=tasdeeq_minio
S3_SECRET_KEY=tasdeeq_minio_dev

LEGACY_ASSET_BASE_URL=https://tasdeequat.cee-solutions.com/tasdeeqPreLive
ASSET_MIGRATE_CONCURRENCY=50
ASSET_JOB_BATCH_SIZE=500
MIGRATE_BATCH_SIZE=2000
UDV_BATCH_SIZE=500
UDV_BULK_CHUNK=500
CRIMINAL_FORM_BATCH_SIZE=500
CRIMINAL_FORM_BULK_CHUNK=500
MAP_SAVE_EVERY=10
