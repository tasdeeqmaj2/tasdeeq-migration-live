{
  "name": "tasdeeq-db-migration",
  "version": "1.0.0",
  "description": "One-time migration from old tasdeeq_prelive PostgreSQL to the new Prisma schema",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "migrate": "node index.js",
    "migrate:fresh": "node index.js --fresh",
    "migrate:assets": "node migrateAssets.js",
    "clear-maps": "node clearMaps.js",
    "reset-target": "node resetTarget.js",
    "create-new-db": "node createNewDb.js",
    "pm2:fresh": "pm2 start ecosystem.config.cjs --only migrate-fresh",
    "pm2:assets": "pm2 start ecosystem.config.cjs --only migrate-assets"
  },
  "keywords": [],
